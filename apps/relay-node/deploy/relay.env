# Deva 手机版中转配置（环境变量，说明见 README）。部署不会覆盖本文件。
# 修改后执行：sudo systemctl restart deva-relay

PORT=8787
# HOST=

# 放在 Cloudflare 代理后面、由本程序直接提供 HTTPS 时（证书用 Cloudflare Origin CA），改为：
# PORT=443
# TLS_CERT=/etc/deva-relay/origin.pem
# TLS_KEY=/etc/deva-relay/origin.key
# 私钥须能被 deva-relay 用户读取：sudo chown root:deva-relay origin.key && sudo chmod 640 origin.key
