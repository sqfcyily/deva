# Deva 手机版中转 systemd 服务示例。
# 复制到 /etc/systemd/system/deva-relay.service，按实际情况修改 node 路径与环境变量后：
#   systemctl daemon-reload && systemctl enable --now deva-relay
# 查看日志：journalctl -u deva-relay -f

[Unit]
Description=Deva relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deva-relay
WorkingDirectory=/opt/deva-relay
ExecStart=/usr/bin/node /opt/deva-relay/relay.cjs
Environment=PORT=8787

# 放在 Cloudflare 代理后面、由本程序直接提供 HTTPS 时（证书用 Cloudflare Origin CA），改用下面几行：
# Environment=PORT=443
# Environment=TLS_CERT=/etc/deva-relay/origin.pem
# Environment=TLS_KEY=/etc/deva-relay/origin.key
# AmbientCapabilities=CAP_NET_BIND_SERVICE

Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/deva-relay/data

[Install]
WantedBy=multi-user.target
