# Deva 手机版中转 systemd 服务（install.sh 会把 __NODE__ 换成服务器上 node 的路径后写入
# /etc/systemd/system/deva-relay.service，每次部署都重写）。端口、证书等配置在 /etc/deva-relay/relay.env。
# 查看日志：journalctl -u deva-relay -f

[Unit]
Description=Deva relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deva-relay
WorkingDirectory=/opt/deva-relay
EnvironmentFile=/etc/deva-relay/relay.env
ExecStart=__NODE__ /opt/deva-relay/relay.cjs
# 允许以普通用户监听 443 等低端口（relay.env 里 PORT=443 时用到）。
AmbientCapabilities=CAP_NET_BIND_SERVICE

Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/deva-relay/data

[Install]
WantedBy=multi-user.target
